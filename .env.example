# URL pública (para SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://survivorpreper.netlify.app

# Stripe Payment Link del plan Pro (créalo en dashboard.stripe.com > Payment Links)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Tag de Amazon Afiliados España (ej: tunombre-21)
NEXT_PUBLIC_AMAZON_TAG=

# Captura de emails (Brevo, servidor en la UE). Si se deja vacío, el email se guarda solo en el navegador.
BREVO_API_KEY=
BREVO_LIST_ID=
# (Opcional) lista aparte para la lista de espera de Pro
BREVO_WAITLIST_LIST_ID=

# Pro: déjalo vacío para "lista de espera". Pon 1 solo cuando exista el cobro real (Fase 2).
NEXT_PUBLIC_PRO_LIVE=

# Datos del aviso legal (obligatorio en España)
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_NIF=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=

# Estadísticas sin cookies: crea una web en cloud.umami.is (gratis) y pega aquí su Website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
